# Neon Serverless PostgreSQL Connection String
# 1. Sign up at https://console.neon.tech/
# 2. Create a project named 'KisanSetu'
# 3. Copy your pooled/direct connection string below:
VITE_NEON_DATABASE_URL=postgresql://neondb_owner:<YOUR_PASSWORD>@<YOUR_ENDPOINT>.neon.tech/neondb?sslmode=require

# App Environment Configuration
VITE_APP_NAME="KisanSetu | Procurement OS"
VITE_APP_ENV=production
